{
  "name": "@omc/validators",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./onboarding": {
      "types": "./dist/onboarding.d.ts",
      "default": "./src/onboarding.ts"
    },
    "./nutrition": {
      "types": "./dist/nutrition.d.ts",
      "default": "./src/nutrition.ts"
    },
    "./workout": {
      "types": "./dist/workout.d.ts",
      "default": "./src/workout.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "watch": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@omc/eslint-config": "workspace:*",
    "@omc/prettier-config": "workspace:*",
    "@omc/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@omc/prettier-config"
}

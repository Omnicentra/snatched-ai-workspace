{
  "name": "@omc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsc",
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "watch": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.796.0",
    "@google/genai": "^0.10.0",
    "@omc/auth": "workspace:*",
    "@omc/db": "workspace:*",
    "@omc/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "lru-cache": "^10.4.3",
    "openai": "^4.97.0",
    "sharp": "^0.34.1",
    "superjson": "2.2.2",
    "uuid": "^11.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@omc/eslint-config": "workspace:*",
    "@omc/prettier-config": "workspace:*",
    "@omc/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@omc/prettier-config"
}

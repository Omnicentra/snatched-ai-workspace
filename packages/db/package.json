{
  "name": "@omc/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "watch": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "generate": "pnpm with-env drizzle-kit generate",
    "migrate": "pnpm with-env drizzle-kit migrate",
    "migrate:prod": "doppler run -p snatched-ai-backend -c prd -- drizzle-kit migrate",
    "push": "pnpm with-env drizzle-kit push",
    "push:prod": "doppler run -p snatched-ai-backend -c prd -- pnpm with-env drizzle-kit push",
    "pull": "pnpm with-env drizzle-kit pull",
    "drop": "pnpm with-env drizzle-kit drop",
    "studio": "pnpm with-env drizzle-kit studio",
    "studio:prod": "doppler run -p snatched-ai-backend -c prd -- drizzle-kit studio",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --",
    "seed": "pnpm with-env tsx src/seed/index.ts",
    "seed:single": "pnpm with-env tsx src/seed/index.ts",
    "seed:prod": "doppler run -p snatched-ai-backend -c prd -- pnpm with-env tsx src/seed/index.ts",
    "seed:prod:single": "doppler run -p snatched-ai-backend -c prd -- pnpm with-env tsx src/seed/index.ts",
    "seed:snatch-hacks": "pnpm with-env tsx src/seed/index.ts --snatch-hacks",
    "seed:snatch-hacks:prod": "doppler run -p snatched-ai-backend -c prd -- pnpm with-env tsx src/seed/index.ts --snatch-hacks"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@omc/validators": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.0",
    "pg": "^8.14.1",
    "tsx": "^4.19.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@omc/eslint-config": "workspace:*",
    "@omc/prettier-config": "workspace:*",
    "@omc/tsconfig": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@omc/prettier-config"
}

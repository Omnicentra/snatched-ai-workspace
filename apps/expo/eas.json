{
  "cli": {
    "version": ">= 4.1.2",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "pnpm": "9.15.4",
      "android": {
        "image": "latest"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "channel": "base"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "COOLDOWN_WORKOUT_ID": "47"
      },
      "channel": "development"
    },
    "ios-simulator": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "development",
        "COOLDOWN_WORKOUT_ID": "47"
      },
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "COOLDOWN_WORKOUT_ID": "47"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "COOLDOWN_WORKOUT_ID": "25"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./certs/google-play-service-account-key.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "chisom.oguibe@googlemail.com",
        "ascAppId": "6744844397",
        "appleTeamId": "U665535C27",
        "sku": "snatched-ai-omnicentra",
        "language": "en-UK",
        "companyName": "Omnicentra"
      }
    }
  }
}

{
  "name": "@omc/expo",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start -c",
    "dev:tunnel": "npx expo start --tunnel",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "ios": "expo run:ios --device",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "eas:local:ios:sim": "eas build --profile ios-simulator --platform ios --local",
    "eas:local:ios": "eas build --profile development --platform ios --local",
    "eas:local:android": "eas build --profile development --platform android --local",
    "eas:preview:ios": "eas build --profile preview --platform ios",
    "eas:preview:android": "eas build --profile preview --platform android",
    "eas:prod:ios": "eas build --profile production --platform ios",
    "eas:prod:android": "eas build --profile production --platform android"
  },

{
  "name": "@omc/nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.796.0",
    "@aws-sdk/s3-request-presigner": "^3.796.0",
    "@omc/api": "workspace:*",
    "@omc/auth": "workspace:*",
    "@omc/db": "workspace:*",
    "@omc/ui": "workspace:*",
    "@omc/validators": "workspace:*",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "geist": "^1.3.1",
    "lucide-react": "^0.503.0",
    "next": "^14.2.28",
    "react": "catalog:react18",
    "react-dom": "catalog:react18",
    "superjson": "2.2.2",
    "uuid": "^11.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.775.0",
    "@omc/eslint-config": "workspace:*",
    "@omc/prettier-config": "workspace:*",
    "@omc/tailwind-config": "workspace:*",
    "@omc/tsconfig": "workspace:*",
    "@types/node": "^22.13.11",
    "@types/react": "catalog:react18",
    "@types/react-dom": "catalog:react18",
    "dotenv-cli": "^8.0.0",
    "eslint": "catalog:",
    "jiti": "^1.21.7",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "trpc-ui": "^1.0.15",
    "typescript": "catalog:"
  },
  "prettier": "@omc/prettier-config"
}
